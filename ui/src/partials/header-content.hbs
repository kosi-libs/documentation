<header class="header">
  <nav class="navbar">
    <div class="navbar-brand">
      <a class="navbar-item" href="https://kodein-koders.com" aria-label="Kodein Koders">
        <img class="navbar-logo" src="{{{uiRootPath}}}/img/logo.svg" alt="Kodein Koders">
      </a>
      <span class="navbar-item navbar-title">Kodein Open Source Initiative{{#if (ne page.component.title "Kodein Open Source Initiative")}}{{#with page.component.title}} &mdash; {{this}}{{/with}}{{/if}}</span>
      {{#if env.SITE_SEARCH_PROVIDER}}
      <div class="navbar-item search hide-for-print">
        <div id="search-field" class="field">
          <input id="search-input" type="text" placeholder="Search the docs"{{#if page.home}} autofocus{{/if}}>
        </div>
      </div>
      {{/if}}
      <button class="navbar-burger" aria-controls="topbar-nav" aria-expanded="false" aria-label="Toggle main menu">
        <span></span>
        <span></span>
        <span></span>
      </button>
    </div>
    <div id="topbar-nav" class="navbar-menu">
      <div class="navbar-end">
        <div class="navbar-item theme-selector">
          <button class="theme-toggle" type="button" aria-haspopup="menu" aria-expanded="false" aria-label="Theme" data-theme-choice="auto"><span class="theme-icon theme-icon-auto"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg></span><span class="theme-icon theme-icon-light"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg></span><span class="theme-icon theme-icon-dark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.7 6.7 0 0 0 10.5 10.5z"/></svg></span></button>
          <div class="theme-menu" role="menu" hidden>
            <button class="theme-option" type="button" role="menuitemradio" aria-checked="false" data-theme-value="auto"><svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg><span>Auto</span></button>
            <button class="theme-option" type="button" role="menuitemradio" aria-checked="false" data-theme-value="light"><svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg><span>Light</span></button>
            <button class="theme-option" type="button" role="menuitemradio" aria-checked="false" data-theme-value="dark"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M20 14.5A8.5 8.5 0 1 1 9.5 4a6.7 6.7 0 0 0 10.5 10.5z"/></svg><span>Dark</span></button>
          </div>
        </div>
        <a class="navbar-item" href="{{{siteRootPath}}}/index.html">KOSI Libs</a>
        <a class="navbar-item" href="{{{or (repo-url (and (ne page.component.name 'kosi-libs') page.origin.url)) 'https://github.com/kosi-libs'}}}" target="_blank" rel="noopener" aria-label="GitHub">
          <span class="icon"><img src="{{{uiRootPath}}}/img/github-light.svg" alt="GitHub"></span>
        </a>
      </div>
    </div>
  </nav>
</header>
